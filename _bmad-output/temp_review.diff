+  color: var(--tj-green);
+  box-shadow: 0 0 10px rgba(34, 197, 94, 0.2);
+}
+
+.tj-side-selector .tj-side-btn.sell.active {
+  background: rgba(239, 68, 68, 0.15);
+  border-color: var(--tj-red);
