+/* ==================== Story 2.4: 交易表单录入样式 ==================== */
+
+/* 录入交易悬浮 FAB 按钮 */
+.tj-record-trade-fab {
+  position: absolute;
+  bottom: 24px;
+  right: 24px;
+  z-index: 10;
+  display: flex;
+  align-items: center;
+  gap: 6px;
+  padding: 10px 18px;
+  border-radius: 24px;
+  border: none;
+  background: linear-gradient(135deg, #10b981 0%, #059669 100%);
+  color: #ffffff;
+  font-size: 13px;
+  font-weight: 600;
+  letter-spacing: 0.5px;
+  cursor: pointer;
+  box-shadow: 0 4px 14px rgba(16, 185, 129, 0.4), inset 0 1px 0 rgba(255, 255, 255, 0.2);
+  transition: all 0.2s cubic-bezier(0.4, 0, 0.2, 1);
+}
+
+.tj-record-trade-fab:hover {
+  transform: translateY(-2px);
+  box-shadow: 0 6px 18px rgba(16, 185, 129, 0.5), inset 0 1px 0 rgba(255, 255, 255, 0.3);
+}
+
+.tj-record-trade-fab:active {
+  transform: translateY(0) scale(0.96);
+  box-shadow: 0 2px 6px rgba(16, 185, 129, 0.3);
+}
+
+/* 遮罩磨砂背景 */
+.tj-trade-form-overlay {
+  position: absolute;
+  top: 0;
+  left: 0;
+  right: 0;
+  bottom: 0;
+  background: rgba(10, 11, 15, 0.65);
+  backdrop-filter: blur(12px);
+  -webkit-backdrop-filter: blur(12px);
+  z-index: 1000;
+  display: flex;
+  align-items: center;
+  justify-content: center;
+  animation: tj-fade-in 0.2s ease-out;
+}
+
+/* 表单玻璃拟态容器 */
+.tj-trade-form-container {
+  background: linear-gradient(135deg, rgba(26, 27, 35, 0.9) 0%, rgba(18, 19, 24, 0.95) 100%);
+  border: 1px solid rgba(255, 255, 255, 0.08);
+  box-shadow: 0 16px 36px rgba(0, 0, 0, 0.65), 0 0 24px rgba(16, 185, 129, 0.03);
+  border-radius: 12px;
+  width: 90%;
+  max-width: 480px;
+  padding: 24px;
+  animation: tj-slide-up 0.25s cubic-bezier(0.16, 1, 0.3, 1);
+}
+
+/* 表单头部 */
+.tj-trade-form-header {
+  display: flex;
+  justify-content: space-between;
+  align-items: center;
+  margin-bottom: 20px;
+  border-bottom: 1px solid rgba(255, 255, 255, 0.08);
+  padding-bottom: 12px;
+}
+
+.tj-trade-form-header h3 {
+  margin: 0;
+  font-size: 15px;
+  font-weight: 600;
+  color: #ffffff;
+  display: flex;
+  align-items: center;
+  gap: 6px;
+}
+
+.tj-trade-form-header .tj-close-btn {
+  background: none;
+  border: none;
+  color: var(--tj-text-secondary);
+  cursor: pointer;
+  font-size: 16px;
+  transition: color 0.15s;
+  padding: 4px;
+  line-height: 1;
+}
+
+.tj-trade-form-header .tj-close-btn:hover {
+  color: #ffffff;
+}
+
