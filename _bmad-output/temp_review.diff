+
+/* 页脚 */
+.tj-trade-form-footer {
+  display: flex;
+  justify-content: flex-end;
+  gap: 10px;
+  margin-top: 10px;
+  border-top: 1px solid rgba(255, 255, 255, 0.08);
+  padding-top: 16px;
+}
+
+.tj-trade-form-footer .tj-footer-cancel-btn {
+  background: rgba(255, 255, 255, 0.05);
+  border: 1px solid rgba(255, 255, 255, 0.1);
+  color: var(--tj-text-secondary);
+  border-radius: 6px;
+  padding: 8px 16px;
+  font-size: 12px;
+  font-weight: 600;
+  cursor: pointer;
+  transition: all 0.2s ease;
+}
+
+.tj-trade-form-footer .tj-footer-cancel-btn:hover {
+  background: rgba(255, 255, 255, 0.1);
+  color: #ffffff;
+  border-color: rgba(255, 255, 255, 0.2);
+}
+
+.tj-trade-form-footer .tj-footer-confirm-btn {
+  background: var(--tj-accent);
+  border: none;
+  color: #ffffff;
+  border-radius: 6px;
+  padding: 8px 20px;
+  font-size: 12px;
+  font-weight: 600;
+  cursor: pointer;
+  transition: all 0.2s ease;
+}
+
+.tj-trade-form-footer .tj-footer-confirm-btn:hover {
+  background: #3cb0ff;
+  box-shadow: 0 0 12px rgba(79, 142, 247, 0.4);
+}
+
+.tj-trade-form-footer .tj-footer-confirm-btn:active {
+  transform: scale(0.97);
+}
+
+/* 消息 Toast 容器 */
+.tj-toast {
+  position: absolute;
+  bottom: 40px;
+  left: 50%;
+  transform: translateX(-50%);
+  background: rgba(30, 31, 41, 0.9);
+  border: 1px solid rgba(239, 68, 68, 0.4);
+  color: var(--tj-text);
+  padding: 8px 16px;
+  border-radius: 20px;
+  box-shadow: 0 4px 14px rgba(0, 0, 0, 0.6);
+  backdrop-filter: blur(8px);
+  -webkit-backdrop-filter: blur(8px);
+  z-index: 1100;
+  pointer-events: none;
+  animation: tj-slide-up 0.2s ease-out;
+}
+
+.tj-trade-form-footer .tj-footer-confirm-btn:disabled {
+  background: rgba(255, 255, 255, 0.1);
+  color: rgba(255, 255, 255, 0.4);
+  cursor: not-allowed;
+  box-shadow: none;
+  transform: none;
+}
+
+.tj-trade-form-footer .tj-btn-loading::before {
+  content: "";
+  display: inline-block;
+  width: 12px;
+  height: 12px;
+  margin-right: 6px;
+  border: 2px solid rgba(255, 255, 255, 0.2);
+  border-top-color: #ffffff;
+  border-radius: 50%;
+  animation: tj-spin 0.8s linear infinite;
+  vertical-align: middle;
+}
+
+@keyframes tj-spin {
+  to {
+    transform: rotate(360deg);
+  }
+}
+
