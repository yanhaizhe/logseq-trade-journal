+}
+
+.tj-selected-chips-container .tj-tag-chip.error.active {
+  background: rgba(239, 68, 68, 0.18);
+  color: var(--tj-red);
+  border-color: var(--tj-red);
+  box-shadow: 0 0 8px rgba(239, 68, 68, 0.25);
