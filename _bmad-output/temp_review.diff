+}
+
+.tj-selected-chips-container .tj-tag-chip {
+  font-size: 11px;
+  padding: 4px 8px;
+  border-radius: 4px;
+  cursor: pointer;
+  border: 1px solid transparent;
+  transition: all 0.15s ease;
+  user-select: none;
+}
+
+.tj-selected-chips-container .tj-tag-chip.strategy.active {
