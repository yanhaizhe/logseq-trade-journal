+  align-items: center;
+  gap: 4px;
+}
+
+/* 标签 Chip 复选区 */
+.tj-tags-chips-container {
+  display: flex;
+  flex-wrap: wrap;
+  gap: 6px;
+  max-height: 110px;
+  overflow-y: auto;
